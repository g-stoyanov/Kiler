<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Templates, records, search, users, permissions, audit. It connects Crypto and Storage.
    The Windows parts are interfaces here; Kiler.App implements them. The exception is the file
    owner, IFileOwner in Kiler.Storage, which the data layer reads through the handle it reads a
    file with (decided at the start of M2, M2.6).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Kiler.Crypto\Kiler.Crypto.csproj" />
    <ProjectReference Include="..\Kiler.Storage\Kiler.Storage.csproj" />
  </ItemGroup>

  <!-- The tests read the content of a model without a document, which only the data layer makes. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kiler.Core.Tests" />
  </ItemGroup>

</Project>
