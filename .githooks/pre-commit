#!/bin/sh
# Blocks a commit whose index, author or committer contains internal terms.
# The check is in .claude/hooks/data-guard.ps1. Enabled for a clone with: git config core.hooksPath .githooks
exec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(dirname "$0")/../.claude/hooks/data-guard.ps1" -Mode pre-commit
