#!/bin/sh
# Blocks a push whose ref names, commits or tags contain internal terms. $1 is the remote, stdin lists the refs.
# The check is in .claude/hooks/data-guard.ps1. Enabled for a clone with: git config core.hooksPath .githooks
exec powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(dirname "$0")/../.claude/hooks/data-guard.ps1" -Mode pre-push "$1"
