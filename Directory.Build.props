<Project>

  <!--
    Shared settings for every project under this folder, including tools/.
    tests/Directory.Build.props imports this file and adds the test settings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      These depend on the machine, not the code: NU1900, the vulnerability feed cannot be reached;
      NU1507, several package sources with central package management. They stay warnings.
      The vulnerability warnings themselves (NU1901-NU1904) stay errors.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1507;NU1900</WarningsNotAsErrors>
    <!-- A newer SDK feature band must not turn on new analyzer rules by itself. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unnecessary using) is reported in the build only with a documentation file. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Kiler.exe is published with Native AOT, so the shipped code is checked as for AOT. -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Kiler</Product>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
