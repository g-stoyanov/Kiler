<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The demo data (PLAN M8 step 4): a made-up Kiler in a data folder, made through the Kiler libraries, so it opens and
    decrypts as a real one. It grows with M5 to M7. The rules are in the kiler-dotnet skill (demodata.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kiler.Core\Kiler.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiler.DemoData.Tests" />
    <!-- The E2E tests start Kiler on a data folder that DemoKiler.Make writes, with the demo users (M6.12). -->
    <InternalsVisibleTo Include="Kiler.E2E" />
  </ItemGroup>

</Project>
