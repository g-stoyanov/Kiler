<Project>

  <!-- The NuGet package versions live only here. The projects reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Kiler.App">
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <!-- The E2E tests. ci.yml keys the cache of the Playwright browsers on this file. -->
  <ItemGroup Label="Kiler.E2E">
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

</Project>
