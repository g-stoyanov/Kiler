<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT has no reflection-based JSON. The tests turn it off too, so a type
    missing from KilerJsonContext fails here and not only in the published exe.
  -->
  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- The API tests run Kiler on the real Kestrel (KilerServer), not on the WebApplicationFactory test server. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kiler.App\Kiler.App.csproj" />
  </ItemGroup>

  <!-- Kiler.App is for Windows only, so the platform analyzer (CA1416) needs the same here to let the tests call it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- FakeTimeProvider: the waits of the single instance without real time. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
